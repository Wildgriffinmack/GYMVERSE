{
  "name": "gymverse-guardian",
  "version": "0.1.0",
  "private": true,
  "description": "GYMVERSE Guardian: self-hosted moderation service (rules + optional local model).",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/main.ts",
    "start:lan": "node --env-file-if-exists=.env src/main.ts --lan",
    "dev": "node --env-file-if-exists=.env --watch src/main.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "~5.9.3"
  }
}
