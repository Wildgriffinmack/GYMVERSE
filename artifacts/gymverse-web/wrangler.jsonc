{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gymx-web",
  "compatibility_date": "2026-10-26",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "html_handling": "none",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*",
      "!/_next/static/*",
      "!/*/_next/static/*"
    ]
  },
  // Waitlist storage (Workers Free includes D1). No database_id: Cloudflare creates the
  // database on the first deploy. To use an existing database instead, add its "database_id".
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gymx-waitlist",
      "migrations_dir": "migrations"
    }
  ],
  // Non-secret settings. Email provider credentials (RESEND_API_KEY) and WAITLIST_HASH_SALT are
  // secrets: set them in the Cloudflare dashboard or with `wrangler secret put`, never here.
  "vars": {
    "NOTIFY_TO": "team@gymx.life",
    "CONFIRMATION_EMAILS_ENABLED": "false"
  }
}
