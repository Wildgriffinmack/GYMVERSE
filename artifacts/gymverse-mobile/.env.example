# Copy to .env.local (git-ignored) to turn on GYMVERSE Guardian moderation.
# Only public, non-secret values belong here: EXPO_PUBLIC_* values are bundled into the app.

# off (default) | auto | http://<laptop-ip>:8787
# "auto" uses the computer that serves the Expo bundle (phone and laptop on the same Wi-Fi).
EXPO_PUBLIC_GUARDIAN_URL=auto
EXPO_PUBLIC_GUARDIAN_PORT=8787
