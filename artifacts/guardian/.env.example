# GYMX Guardian configuration. Copy to .env (git-ignored) and adjust.
# Nothing here is a third-party API key: Guardian never calls external AI services.

# ── Network ─────────────────────────────────────────────────────────────
# 127.0.0.1 = this computer only. Use `npm run start:lan` to let phones on your Wi-Fi reach /v1/moderate.
GUARDIAN_HOST=127.0.0.1
GUARDIAN_PORT=8787
GUARDIAN_RATE_LIMIT_PER_MIN=60
GUARDIAN_BODY_LIMIT_BYTES=32768
# Only for browser clients on other origins (the Expo app does not need CORS).
GUARDIAN_CORS_ORIGINS=
# Only when running behind a reverse proxy you control.
GUARDIAN_TRUST_PROXY=false

# ── Moderator access ────────────────────────────────────────────────────
# Leave empty during local development to get a random token printed at startup.
# Production: generate with `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`
GUARDIAN_ADMIN_TOKEN=
# Separate credential that may reveal private direct messages (audited). Leave empty to disable reveal.
GUARDIAN_TRUST_SAFETY_TOKEN=
# Admin API and dashboard are loopback-only. Only set true behind an authenticated, TLS-terminating proxy.
GUARDIAN_ADMIN_ALLOW_REMOTE=false

# ── Local model (Stage 2) ───────────────────────────────────────────────
# none = rules only. ollama = local Ollama runtime.
GUARDIAN_MODEL_PROVIDER=none
# Recommended to benchmark first: qwen3:4b (2.5 GB). Policy-tuned option: gpt-oss-safeguard:20b (14 GB).
GUARDIAN_MODEL=
OLLAMA_URL=http://127.0.0.1:11434
# false for most models; gpt-oss models take low | medium | high.
GUARDIAN_MODEL_THINK=false
GUARDIAN_MODEL_TIMEOUT_MS=15000
GUARDIAN_MODEL_CONCURRENCY=2
GUARDIAN_MODEL_MAX_WAITING=32
# true = also ask the model about content the rules approved (more GPU load).
GUARDIAN_MODEL_SCREEN_ALL=false

# ── Policy ──────────────────────────────────────────────────────────────
# Private newline-separated hate-speech lexicon. Keep it out of git.
GUARDIAN_LEXICON_PATH=
GUARDIAN_DEMO_DATA=true
GUARDIAN_LOG_LEVEL=info
